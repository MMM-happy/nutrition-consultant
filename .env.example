# Optional: used by the AI text and photo analysis endpoints.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional override for shared records. The default public shared-wall connection is already configured.
# Do not use SUPABASE_SERVICE_ROLE_KEY in this project.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
